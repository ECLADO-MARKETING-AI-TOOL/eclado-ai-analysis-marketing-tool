{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["eclado_backend.main:app", "--app-dir", "backend", "--reload"],
      "jinja": true
    },
    {
      "name": "Streamlit admin",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "admin/eclado_admin/main.py"]
    }
  ]
}
